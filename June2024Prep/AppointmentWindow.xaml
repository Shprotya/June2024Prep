<Window x:Class="June2024Prep.AppointmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}"
        Title="AppointmentWindow" Height="380" Width="520"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Date and Time pickers -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DatePicker Grid.Column="0"
                        x:Name="dpAppointmentDate"
                        Margin="0,0,8,0"
                        materialDesign:HintAssist.Hint="Appointment Date"
                        Style="{StaticResource MaterialDesignFloatingHintDatePicker}"/>

            <materialDesign:TimePicker Grid.Column="1"
                                       x:Name="tpAppointmentTime"
                                       materialDesign:HintAssist.Hint="Appointment Time"
                                       Style="{StaticResource MaterialDesignFloatingHintTimePicker}"/>
        </Grid>

        <!-- Row 1: Notes label -->
        <TextBlock Grid.Row="1"
                   Text="Notes"
                   Margin="0,0,0,4"
                   Style="{StaticResource MaterialDesignBody1TextBlock}"/>

        <!-- Row 2: Notes text area -->
        <TextBox Grid.Row="2"
                 x:Name="tbxNotes"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,8"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

        <!-- Row 3: Action buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="btnAdd"
                    Content="Add"
                    Click="AddAppointment_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="0,0,8,0"/>
            <Button x:Name="btnUpdate"
                    Content="Update"
                    Click="UpdateAppointment_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>
